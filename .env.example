# 복사해서 .env 로 이름을 바꾼 뒤 사용 (cp .env.example .env)
# .env 는 .gitignore에 포함되어 커밋되지 않는다.

# 04 노트북(RAGAS)용
OPENAI_API_KEY=sk-...

# 검색 모듈(src/rag_search.py) 설정. 지우거나 비워 두면 기본값으로 동작
QDRANT_HOST=localhost
QDRANT_PORT=6333
# RAG_DEVICE=mps          # cuda / mps / cpu 강제 지정 (기본: 자동 감지)
# RAG_USE_FP16=0          # 1이면 fp16 강제 사용 (기본: CUDA에서만 사용)
